{
  "name": "messenger",
  "version": "1.0.0",
  "description": "Windows 3.1–styled messenger SPA with an in-browser mock backend",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "prepare": "husky install",
    "clean": "rimraf node_modules/",
    "build": "webpack && node scripts/copy-404.js",
    "build:gh-pages": "PUBLIC_PATH=/windows-3.1-retro-style-messenger/ webpack && node scripts/copy-404.js",
    "start": "npm run build && node server.js",
    "dev": "webpack serve --mode=development --progress",
    "lint": "eslint ./src",
    "test": "jest",
    "stylelint": "stylelint ./src/**/*.css"
  },
  "keywords": [
    "messenger",
    "windows-3.1",
    "typescript",
    "spa"
  ],
  "author": "Alexander Ershov",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "7.1.5",
    "dotenv": "16.6.1",
    "dotenv-webpack": "8.1.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript-prettier": "5.0.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "4.2.1",
    "html-webpack-plugin": "5.6.8",
    "husky": "8.0.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.31",
    "postcss-loader": "8.2.1",
    "postcss-nested": "9.0.1",
    "rimraf": "6.1.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.112.0",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.1.0"
  },
  "dependencies": {
    "express": "4.22.3",
    "handlebars": "4.7.10",
    "nanoid": "3.3.20"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@4": "4.0.1",
    "braces": "3.0.3",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@7": "7.4.9",
    "minimatch@8": "8.0.7",
    "minimatch@9": "9.0.9",
    "nanoid@3": "3.3.20",
    "postcss": "8.5.31",
    "source-map-js": "1.2.2",
    "websocket-driver": "0.7.5"
  }
}
